# ===== 规范智能问答助手系统 环境变量示例 =====
# 复制为 .env 后按需修改；docker compose up 会自动读取同目录下的 .env

# ----- LLM API 密钥加密密钥（Fernet key）-----
# 生产环境必须设置。生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时后端会派生一个固定开发密钥（仅用于本地调试，不安全）
LLM_ENCRYPT_KEY=

# ----- MinerU 文档解析服务（可选）-----
# 若已本地部署 MinerU，填其基地址；留空则使用内置本地解析（pypdf/python-docx）
MINERU_API_URL=

# ----- Embedding 向量化服务 -----
# 默认使用本地 sentence-transformers 模型（BAAI/bge-small-zh-v1.5，512维）
# 若配置远程 API，则优先使用远程；失败时自动降级本地模型
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 以下 Embedding 键的默认值见 backend/app/config.py；留空 = 用默认值
EMBEDDING_DIM=
EMBEDDING_USE_LOCAL=
EMBEDDING_DEVICE=
LOCAL_EMBEDDING_MODEL=

# ----- RAG 混合检索配置 -----
# 以下键默认值单一来源 = backend/app/config.py（docker-compose 只做 ${VAR:-} 纯透传）；
# 留空/不配置 = 用 config.py 默认值；需要覆盖时在此填写。
ENABLE_QUERY_REWRITE=
ENABLE_RERANK=
RETRIEVE_MODE=
HYBRID_BM25_WEIGHT=
HYBRID_VECTOR_WEIGHT=
RAG_TOP_K=
VECTOR_SCORE_THRESHOLD=
ENABLE_SUBSTRING_BOOST=
SUBSTRING_PHRASE_WEIGHT=
ENABLE_LITERAL_FORCE_INJECT=

# ----- Embedding 查询指令（V1.2.3，仅 bge 系查询侧加前缀，文档侧不加，无需重索引）-----
# 官方指令用于短查询/同义查询召回提升；置空即禁用
# EMBEDDING_QUERY_PROMPT=为这个句子生成表示以用于检索相关文章：
# EMBEDDING_QUERY_PROMPT_MODELS=bge

# ----- 大文档入库上限（V1.2.3）-----
# 单文档入库文本上限（字符），避免大规范靠后章节被截断丢失；按机器内存调大
# DOC_TEXT_CAP=500000
# 单文档最大分块数（配合 DOC_TEXT_CAP，防止块数截断丢尾部）
# CHUNK_MAX_COUNT=1500

# ----- CORS 允许来源 -----
CORS_ORIGINS=*
