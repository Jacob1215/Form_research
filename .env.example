# ===== 规范智能问答助手系统 环境变量示例 =====
# 复制为 .env 后按需修改；docker compose up 会自动读取同目录下的 .env

# ----- LLM API 密钥加密密钥（Fernet key）-----
# 生产环境必须设置。生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时后端会派生一个固定开发密钥（仅用于本地调试，不安全）
LLM_ENCRYPT_KEY=

# ----- MinerU 文档解析服务（可选）-----
# 若已本地部署 MinerU，填其基地址；留空则使用内置本地解析（pypdf/python-docx）
MINERU_API_URL=

# ----- Embedding 向量化服务 -----
# 默认使用本地 sentence-transformers 模型（BAAI/bge-small-zh-v1.5，512维）
# 若配置远程 API，则优先使用远程；失败时自动降级本地模型
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=512
EMBEDDING_USE_LOCAL=true
EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ----- RAG 混合检索配置 -----
ENABLE_QUERY_REWRITE=true
ENABLE_RERANK=false
HYBRID_BM25_WEIGHT=0.3
HYBRID_VECTOR_WEIGHT=0.7

# ----- CORS 允许来源 -----
CORS_ORIGINS=*
