# ===== 规范智能问答助手系统 环境变量示例 =====
# 复制为 .env 后按需修改；docker compose up 会自动读取同目录下的 .env

# ----- LLM API 密钥加密密钥（Fernet key）-----
# 生产环境必须设置。生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时后端会派生一个固定开发密钥（仅用于本地调试，不安全）
LLM_ENCRYPT_KEY=

# ----- MinerU 文档解析服务（可选）-----
# 若已本地部署 MinerU，填其基地址；留空则使用内置本地解析（pypdf/python-docx）
MINERU_API_URL=

# ----- Embedding 向量化服务（可选）-----
# 留空时使用内置本地哈希向量（384 维，开箱即用但检索精度有限）
# 配置后调用 OpenAI 兼容的 /embeddings 接口；维度必须与 EMBEDDING_DIM 一致
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# ----- CORS 允许来源 -----
CORS_ORIGINS=*
